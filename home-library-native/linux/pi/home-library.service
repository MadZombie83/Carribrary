[Unit]
Description=Carribrary household library server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=home-library
Group=home-library
Environment=HOME_LIBRARY_DATA=/var/lib/home-library
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
EnvironmentFile=-/etc/home-library/home-library.env
ExecStart=/opt/home-library/server/HomeLibrary.Server
WorkingDirectory=/var/lib/home-library
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/home-library /var/lib/home-library-libraries

[Install]
WantedBy=multi-user.target
