[Desktop Entry]
Type=Application
Name=Carribrary
Comment=Catalog books and manage household loans
Exec=home-library
Icon=com.household.HomeLibrary
Categories=Office;Database;
Terminal=false
Actions=Stop;Recovery;PublicSharing;

[Desktop Action Stop]
Name=Stop library server
Exec=home-library --stop


[Desktop Action Recovery]
Name=Complete Backup Recovery
Exec=home-library --recovery

[Desktop Action PublicSharing]
Name=Public sharing setup
Exec=home-library --public-sharing
